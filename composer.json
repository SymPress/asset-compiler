{
    "name": "sympress/asset-compiler",
    "description": "Composer plugin for compiling frontend assets in SymPress and WordPress package workspaces.",
    "type": "composer-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Brian Schaffner",
            "email": "brian.schaeffner@sympress.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "composer-plugin-api": "^2.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-zip": "*",
        "symfony/filesystem": "^8.0",
        "symfony/finder": "^8.0",
        "symfony/process": "^5.4.47 || ^6.4.25 || ^7.1.10 || ^8.0",
        "symfony/serializer": "^8.0"
    },
    "require-dev": {
        "composer/composer": "^2.10",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "sympress/coding-standards": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "SymPress\\AssetCompiler\\": "src/"
        }
    },
    "extra": {
        "class": "SymPress\\AssetCompiler\\Composer\\Plugin"
    },
    "scripts": {
        "cs": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/package-quality.php cs"
        ],
        "cs:fix": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/package-quality.php cs:fix"
        ],
        "static-analysis": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/package-quality.php static-analysis"
        ],
        "tests": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/package-quality.php tests"
        ],
        "qa": [
            "@cs",
            "@static-analysis",
            "@tests"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "./../*",
            "options": {
                "symlink": true
            }
        }
    ]
}
